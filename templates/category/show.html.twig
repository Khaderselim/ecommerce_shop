{% extends 'base.html.twig' %}

{% block title %}Category{% endblock %}
{% block page_title %}<h2>Category Management</h2>{% endblock %}
{% block panel_heading %}Category Information: {{ category.title }}{% endblock %}

{% block body %}


    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ category.title }}</td>
            </tr>
        </tbody>
    </table>

    <div class="btn-toolbar" role="toolbar" aria-label="Category actions">
        <div class="btn-group" role="group" aria-label="Edit category">
            <a class="btn btn-default" href="{{ path('app_category_edit', {'id': category.id}) }}">edit</a>
        </div>
        <div class="btn-group" role="group" aria-label="Delete category">
            {{ include('category/_delete_form.html.twig') }}
        </div>
    </div>

{% endblock %}
