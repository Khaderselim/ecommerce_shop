{% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}
{% block panel_heading %}Product: {{ product.name }}{% endblock %}
{% block body %}

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ product.price }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ product.description }}</td>
            </tr>
        </tbody>
    </table>

    <div class="btn-toolbar" role="toolbar" aria-label="Product actions">
        <div class="btn-group" role="group" aria-label="Edit product">
            <a class="btn btn-default" href="{{ path('app_product_edit', {'id': product.id}) }}">Edit</a>
        </div>
        <div class="btn-group" role="group" aria-label="Delete product">
            {{ include('product/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
